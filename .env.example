# Everything is optional. With no keys the app runs end to end using the built-in PayPal simulator
# and the rule-based intake extractor.

# --- PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=            # id of the webhook you registered for INVOICING.INVOICE.PAID
# PAYPAL_MODE=mock            # force the simulator even when credentials are present

# --- Claude: intake agent and owner copilot (both have offline fallbacks) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# --- Your company ---
COMPANY_NAME=Nile Movers
COMPANY_EMAIL=
CURRENCY=USD

# --- Rate card ---
RATE_HOURLY_2_MOVERS=95
RATE_EXTRA_MOVER=35
RATE_MIN_HOURS=3
DEPOSIT_PCT=0.25
EARLY_PAY_DISCOUNT_PCT=5

# --- Server ---
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_KEY=                    # required with real PayPal keys; owner routes then need X-Admin-Key
DEMO_SEED=0                   # 1 = start with sample jobs in simulator mode (hosted demo)
DB_PATH=movedesk.db
SCHEDULER_INTERVAL_SECONDS=600   # reminders and discount expiry; 0 turns the scheduler off
